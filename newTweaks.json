  "WPFTweaksDisplay": {
    "Content": "Visual effects",
    "ControlType": "select",
    "DefaultOption": "balanced",
    "PresetOption": "balanced",
    "Description": "Choose how Windows balances appearance and responsiveness.",
    "category": "Performance",
    "registry": [
      {
        "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
        "Name": "VisualFXSetting",
        "Value": "3",
        "Type": "DWord",
        "OriginalValue": "1"
      },
      {
        "Path": "HKCU:\\Control Panel\\Desktop",
        "Name": "FontSmoothing",
        "Value": "2",
        "Type": "String",
        "OriginalValue": "1"
      },
      {
        "Path": "HKCU:\\Control Panel\\Desktop",
        "Name": "FontSmoothingType",
        "Value": "2",
        "Type": "DWord",
        "OriginalValue": "1"
      }
    ],
    "InvokeScript": [
      "Set-ItemProperty -Path \"HKCU:\\Control Panel\\Desktop\" -Name \"UserPreferencesMask\" -Type Binary -Value ([byte[]](144,18,7,128,16,0,0,0))",
      "RUNDLL32.EXE user32.dll,UpdatePerUserSystemParameters"
    ],
    "UndoScript": [
      "Remove-ItemProperty -Path \"HKCU:\\Control Panel\\Desktop\" -Name \"UserPreferencesMask\" -ErrorAction SilentlyContinue",
      "RUNDLL32.EXE user32.dll,UpdatePerUserSystemParameters"
    ],
    "Options": [
      {
        "key": "fancy",
        "label": "Fancy",
        "registry": [
          { "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects", "Name": "VisualFXSetting", "Value": "1", "Type": "DWord" },
          { "Path": "HKCU:\\Control Panel\\Desktop", "Name": "FontSmoothing", "Value": "2", "Type": "String" },
          { "Path": "HKCU:\\Control Panel\\Desktop", "Name": "FontSmoothingType", "Value": "2", "Type": "DWord" }
        ],
        "InvokeScript": [
          "Set-ItemProperty -Path \"HKCU:\\Control Panel\\Desktop\" -Name \"UserPreferencesMask\" -Type Binary -Value ([byte[]](255,255,255,127,16,0,0,0))",
          "RUNDLL32.EXE user32.dll,UpdatePerUserSystemParameters"
        ]
      },
      {
        "key": "balanced",
        "label": "Balanced",
        "registry": [
          { "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects", "Name": "VisualFXSetting", "Value": "3", "Type": "DWord" },
          { "Path": "HKCU:\\Control Panel\\Desktop", "Name": "FontSmoothing", "Value": "2", "Type": "String" },
          { "Path": "HKCU:\\Control Panel\\Desktop", "Name": "FontSmoothingType", "Value": "2", "Type": "DWord" }
        ],
        "InvokeScript": [
          "Set-ItemProperty -Path \"HKCU:\\Control Panel\\Desktop\" -Name \"UserPreferencesMask\" -Type Binary -Value ([byte[]](144,18,7,128,16,0,0,0))",
          "RUNDLL32.EXE user32.dll,UpdatePerUserSystemParameters"
        ]
      },
      {
        "key": "fast",
        "label": "Fast",
        "registry": [
          { "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects", "Name": "VisualFXSetting", "Value": "2", "Type": "DWord" },
          { "Path": "HKCU:\\Control Panel\\Desktop", "Name": "FontSmoothing", "Value": "0", "Type": "String" },
          { "Path": "HKCU:\\Control Panel\\Desktop", "Name": "FontSmoothingType", "Value": "0", "Type": "DWord" }
        ],
        "InvokeScript": [
          "Set-ItemProperty -Path \"HKCU:\\Control Panel\\Desktop\" -Name \"UserPreferencesMask\" -Type Binary -Value ([byte[]](144,18,3,128,16,0,0,0))",
          "RUNDLL32.EXE user32.dll,UpdatePerUserSystemParameters"
        ]
      }
