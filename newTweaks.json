  "WPFTweaksOptimizeSSD": {
    "RequiresAdmin": true,
    "Content": "SSD Maintenance - ReTrim",
    "Description": "Runs Windows built-in TRIM maintenance on the system drive when it is an SSD. It does not defragment the drive.",
    "category": "Storage",
    "ControlType": "button",
    "ActionLabel": "Run maintenance",
    "InvokeScript": [
      "$volume = Get-Volume -DriveLetter C -ErrorAction Stop; $disk = Get-Partition -DriveLetter C | Get-Disk; if ($disk.BusType -ne 'USB' -and $disk.MediaType -eq 'SSD') { Optimize-Volume -DriveLetter C -ReTrim -Verbose } else { Write-Host 'System drive is not a supported SSD; skipped.' }"
    ],
    "Timeout": 180,
    "link": "https://learn.microsoft.com/powershell/module/storage/optimize-volume"
  },
  "WPFTweaksStorageSenseEnable": {
    "Content": "Storage Sense - Enable",
    "Description": "Lets Windows automatically remove safe temporary files while leaving Downloads alone by default.",
    "category": "Storage",
    "ControlType": "toggle",
    "ActionLabel": "Enable",
    "registry": [
      {
        "Path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\StorageSense\\Parameters\\StoragePolicy",
        "Name": "01",
        "Value": "1",
        "Type": "DWord",
        "OriginalValue": "0"
      }
    ],
    "link": "https://support.microsoft.com/windows/manage-drive-space-with-storage-sense"
  },
  "WPFTweaksDisableGameBar": {
    "Content": "Game Bar Integration - Disable",
    "Description": "Stops the Game Bar popup from appearing when you launch a game or connect a controller.",
    "category": "Performance",
    "ControlType": "toggle",
    "ActionLabel": "Disable",
    "registry": [
      { "Path": "HKCU:\\SOFTWARE\\Microsoft\\GameBar", "Name": "UseNexusForGameBarEnabled", "Value": "0", "Type": "DWord", "OriginalValue": "1" }
