  "WPFTweaksHAGS": {
    "RequiresAdmin": true,
    "Content": "Hardware-Accelerated GPU Scheduling - Enable",
    "Description": "Enables GPU scheduling only when Windows and a graphics driver are present. Results vary by hardware; restart Windows after applying.",
