<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#1A1C23">
<title>John’s Windows Fixer — Optimize, Clean &amp; Protect Windows</title>
<meta name="description" content="Windows slow, cluttered, and full of ads? John's Windows Fixer speeds it back up — one click, fully reversible, with a restore point created first.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ============================================================
   John's Windows Fixer — Material 3 Expressive landing page
   Tokens mirror the desktop app's dynamic palette (dark).
   ============================================================ */
:root{
  --bg:#1A1C23;
  --surface:#1E2129;
  --surface-low:#232733;
  --surface-container:#242833;
  --surface-high:#2A2E3A;
  --on-surface:#E6E8F2;
  --on-surface-variant:#C2C6D0;
  --primary:#DFE278;
  --on-primary:#2A3100;
  --primary-container:#4A530F;
  --on-primary-container:#ECF09B;
  --secondary:#C6C9A6;
  --on-secondary:#2F3313;
  --secondary-container:#474B2A;
  --on-secondary-container:#E4E8BC;
  --tertiary:#A6D9C0;
  --tertiary-container:#2C5242;
  --on-tertiary-container:#C1F2DC;
  --error:#FFB4AB;
  --outline:#8B909C;
  --outline-variant:#43474F;
  --radius-xl:28px;
  --radius-lg:20px;
  --radius-md:16px;
  --ease-spring:cubic-bezier(.2,.9,.3,1.18);
  --ease-out:cubic-bezier(.2,.8,.2,1);
  --appbar-h:72px;
  font-family:"Plus Jakarta Sans","Google Sans","Segoe UI",system-ui,-apple-system,sans-serif;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  background:var(--bg);
  color:var(--on-surface);
  line-height:1.6;
  overflow-x:hidden;
  -webkit-tap-highlight-color:transparent;
}
::selection{background:var(--primary);color:var(--on-primary)}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;touch-action:manipulation}
ul{list-style:none}
/* keep grid/flex children shrinkable so no horizontal overflow at any width */
.hero-inner > *,.preset-body > *,.debloat-layout > *,.preset-tweaks > *,.feature-grid > *,.safety-grid > *{min-width:0}

/* ---------- Focus ---------- */
:focus-visible{
  outline:3px solid var(--primary);
  outline-offset:2px;
  border-radius:8px;
}

/* ---------- Skip link ---------- */
.skip-link{
  position:fixed;top:-64px;left:16px;z-index:200;
  background:var(--primary);color:var(--on-primary);
  font-weight:700;padding:12px 20px;border-radius:999px;
  transition:transform .25s var(--ease-out);
}
.skip-link:focus{transform:translateY(72px)}

/* ---------- Container ---------- */
.wrap{width:min(1160px,92vw);margin-inline:auto}

/* ============================================================
   App bar
   ============================================================ */
.appbar{
  position:sticky;top:0;z-index:100;
  height:var(--appbar-h);
  display:flex;align-items:center;
  background:color-mix(in srgb,var(--bg) 78%,transparent);
  backdrop-filter:blur(18px) saturate(1.4);
  -webkit-backdrop-filter:blur(18px) saturate(1.4);
  border-bottom:1px solid transparent;
  transition:border-color .3s var(--ease-out), background-color .3s var(--ease-out);
}
.appbar.scrolled{
  border-bottom-color:var(--outline-variant);
  background:color-mix(in srgb,var(--bg) 88%,transparent);
}
.appbar-inner{display:flex;align-items:center;gap:24px;height:100%}
.brand{display:flex;align-items:center;gap:12px;font-weight:800;font-size:1.06rem;letter-spacing:-.01em}
.brand svg{width:34px;height:34px;flex:none;animation:logo-spin 24s linear infinite}
@keyframes logo-spin{to{transform:rotate(360deg)}}
.brand small{display:block;font-size:.68rem;font-weight:600;color:var(--on-surface-variant);letter-spacing:.06em;text-transform:uppercase;margin-top:-2px}
.appbar-nav{display:flex;gap:4px;margin-left:auto}
.nav-link{
  position:relative;padding:10px 16px;border-radius:999px;
  font-weight:600;font-size:.92rem;color:var(--on-surface-variant);
  transition:color .25s var(--ease-out), background-color .25s var(--ease-out);
}
.nav-link::before{
  content:"";position:absolute;inset:0;border-radius:inherit;
  background:var(--on-surface);opacity:0;transition:opacity .25s var(--ease-out);
}
.nav-link:hover{color:var(--on-surface)}
.nav-link:hover::before{opacity:.06}
.nav-link:active{transform:scale(.96)}
.appbar-actions{display:flex;align-items:center;gap:12px;margin-left:8px}

/* ---------- Buttons (M3) ---------- */
.btn{
  position:relative;display:inline-flex;align-items:center;justify-content:center;gap:10px;
  min-height:48px;padding:0 26px;border-radius:999px;
  font-weight:700;font-size:.98rem;letter-spacing:.01em;white-space:nowrap;
  overflow:hidden;isolation:isolate;
  transition:transform .3s var(--ease-spring), background-color .3s var(--ease-out), box-shadow .3s var(--ease-out);
}
.btn svg{width:20px;height:20px;flex:none}
.btn::before{
  content:"";position:absolute;inset:0;border-radius:inherit;z-index:-1;
  background:#fff;opacity:0;transition:opacity .25s var(--ease-out);
}
.btn:hover{transform:translateY(-2px)}
.btn:hover::before{opacity:.1}
.btn:active{transform:translateY(0) scale(.97)}
.btn-filled{background:var(--primary);color:var(--on-primary);box-shadow:0 6px 20px -6px rgba(223,226,120,.35)}
.btn-filled:hover{box-shadow:0 10px 28px -8px rgba(223,226,120,.5)}
.btn-filled::before{background:#000}
.btn-filled:hover::before{opacity:.08}
.btn-tonal{background:var(--secondary-container);color:var(--on-secondary-container)}
.btn-outlined{background:transparent;color:var(--on-surface);border:1.5px solid var(--outline)}
.btn-text{background:transparent;color:var(--primary);padding:0 16px}
.btn-lg{min-height:60px;padding:0 36px;font-size:1.08rem}
.btn-lg svg{width:24px;height:24px}
.btn-sm{min-height:40px;padding:0 20px;font-size:.88rem}

/* ---------- Chips ---------- */
.chip{
  display:inline-flex;align-items:center;gap:8px;
  min-height:34px;padding:0 16px;border-radius:999px;
  background:var(--surface-container);border:1px solid var(--outline-variant);
  font-size:.82rem;font-weight:600;color:var(--on-surface-variant);
}

/* ============================================================
   Hero
   ============================================================ */
.hero{
  position:relative;overflow:hidden;
  padding:clamp(64px,9vw,120px) 0 clamp(56px,7vw,96px);
}
.orb{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;z-index:0}
.orb-1{width:560px;height:560px;top:-180px;left:-140px;background:radial-gradient(circle,rgba(223,226,120,.16),transparent 65%);animation:drift 16s ease-in-out infinite alternate}
.orb-2{width:520px;height:520px;bottom:-200px;right:-160px;background:radial-gradient(circle,rgba(166,217,192,.13),transparent 65%);animation:drift 19s ease-in-out infinite alternate-reverse}
.orb-3{width:380px;height:380px;top:30%;right:34%;background:radial-gradient(circle,rgba(198,201,166,.08),transparent 65%);animation:drift 22s ease-in-out infinite alternate}
@keyframes drift{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(60px,40px,0) scale(1.12)}}
.hero-inner{
  position:relative;z-index:1;
  display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,6vw,72px);align-items:center;
}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;margin-bottom:24px}
.hero-eyebrow .dot{width:8px;height:8px;border-radius:50%;background:var(--tertiary);box-shadow:0 0 12px var(--tertiary)}
.hero h1{
  font-size:clamp(2.7rem,6vw,4.6rem);
  line-height:1.04;font-weight:800;letter-spacing:-.03em;
  text-wrap:balance;text-shadow:0 4px 40px rgba(0,0,0,.35);
}
.hero h1 .accent{
  background:linear-gradient(100deg,var(--primary) 10%,var(--tertiary) 90%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero-sub{
  margin-top:24px;max-width:52ch;
  color:var(--on-surface-variant);font-size:clamp(1.02rem,1.4vw,1.18rem);font-weight:500;
}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:36px}
.hero-note{margin-top:18px;font-size:.85rem;color:var(--on-surface-variant);display:flex;align-items:center;gap:8px}
.hero-note svg{width:16px;height:16px;color:var(--tertiary);flex:none}
.hero-stats{
  display:grid;grid-template-columns:repeat(4,auto);gap:clamp(20px,3vw,44px);
  margin-top:56px;padding-top:32px;border-top:1px solid var(--outline-variant);
}
.stat b{
  display:block;font-size:clamp(1.5rem,2.4vw,2.1rem);font-weight:800;letter-spacing:-.02em;
  font-variant-numeric:tabular-nums;color:var(--primary);
}
.stat span{font-size:.84rem;font-weight:600;color:var(--on-surface-variant)}

/* ---------- Hero blob stage ---------- */
.blob-stage{position:relative;width:min(46vw,400px);aspect-ratio:1;margin-inline:auto}
.blob-halo{
  position:absolute;inset:-6%;border-radius:50%;
  background:radial-gradient(circle,rgba(223,226,120,.28),rgba(166,217,192,.1) 55%,transparent 72%);
  filter:blur(28px);animation:breathe 4.5s ease-in-out infinite;
}
@keyframes breathe{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.08);opacity:1}}
.blob{
  position:absolute;inset:0;width:100%;height:100%;
  filter:drop-shadow(0 18px 44px rgba(0,0,0,.45));
  animation:blob-rot 26s linear infinite;
}
@keyframes blob-rot{to{transform:rotate(360deg)}}
.orbit{
  position:absolute;inset:0;animation:orbit-spin 30s linear infinite;
}
@keyframes orbit-spin{to{transform:rotate(360deg)}}
.occ{position:absolute;left:50%;top:50%}
.occ-1{transform:translate(-50%,-50%) translateY(-61%)}
.occ-2{transform:translate(-50%,-50%) translate(53%,48%)}
.occ-3{transform:translate(-50%,-50%) translate(-52%,55%)}
.occ-rot{animation:occ-spin 30s linear infinite}
@keyframes occ-spin{to{transform:rotate(-360deg)}}
.occ-pill{
  display:inline-flex;align-items:center;gap:6px;
  padding:10px 18px;border-radius:999px;
  background:color-mix(in srgb,var(--surface-high) 84%,transparent);
  border:1px solid var(--outline-variant);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  font-size:.8rem;font-weight:700;color:var(--on-surface);
  box-shadow:0 8px 24px -8px rgba(0,0,0,.5);
  white-space:nowrap;
  animation:occ-bob 4s ease-in-out infinite;
}
.occ-2 .occ-pill{animation-delay:1.2s}
.occ-3 .occ-pill{animation-delay:.6s}
.occ-pill svg{width:15px;height:15px;color:var(--primary);flex:none}
@keyframes occ-bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}

/* ============================================================
   Marquee
   ============================================================ */
.marquee{
  border-block:1px solid var(--outline-variant);
  background:var(--surface);
  overflow:hidden;padding:18px 0;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
}
.marquee-track{display:flex;gap:56px;width:max-content;animation:marquee 34s linear infinite}
.marquee:hover .marquee-track{animation-play-state:paused}
.marquee-item{display:flex;align-items:center;gap:14px;font-weight:700;font-size:.92rem;color:var(--on-surface-variant);white-space:nowrap}
.marquee-item svg{width:18px;height:18px;color:var(--primary);flex:none}
@keyframes marquee{to{transform:translateX(-50%)}}

/* ============================================================
   Sections (shared)
   ============================================================ */
section{padding:clamp(72px,9vw,120px) 0;scroll-margin-top:var(--appbar-h)}
.sec-head{max-width:640px;margin-bottom:clamp(40px,5vw,64px)}
.sec-eyebrow{
  display:inline-block;margin-bottom:14px;
  font-size:.76rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--primary);
}
.sec-head h2{font-size:clamp(1.9rem,3.6vw,2.9rem);font-weight:800;letter-spacing:-.025em;line-height:1.12;text-wrap:balance}
.sec-head p{margin-top:14px;color:var(--on-surface-variant);font-size:1.05rem}

/* ---------- Reveal ---------- */
[data-reveal]{opacity:0;transform:translateY(26px);transition:opacity .7s var(--ease-out),transform .7s var(--ease-out);transition-delay:var(--d,0s)}
[data-reveal].in{opacity:1;transform:none}

/* ============================================================
   Features
   ============================================================ */
.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.feature-card{
  position:relative;overflow:hidden;isolation:isolate;
  background:var(--surface);border:1px solid var(--outline-variant);
  border-radius:var(--radius-xl);padding:30px 28px;
  transition:transform .4s var(--ease-spring),border-color .3s var(--ease-out),background-color .3s var(--ease-out);
}
.feature-card::before{
  content:"";position:absolute;inset:0;border-radius:inherit;z-index:-1;
  background:radial-gradient(120% 90% at 20% 0%,var(--primary-container) 0%,transparent 55%);
  opacity:0;transition:opacity .4s var(--ease-out);
}
.feature-card:hover{transform:translateY(-8px);border-color:color-mix(in srgb,var(--primary) 45%,var(--outline-variant))}
.feature-card:hover::before{opacity:.5}
.feature-icon{
  width:56px;height:56px;border-radius:18px;margin-bottom:22px;
  display:flex;align-items:center;justify-content:center;
  background:var(--primary-container);color:var(--on-primary-container);
  transition:border-radius .4s var(--ease-spring),transform .4s var(--ease-spring);
}
.feature-card:nth-child(3n+2) .feature-icon{background:var(--tertiary-container);color:var(--on-tertiary-container)}
.feature-card:nth-child(3n+3) .feature-icon{background:var(--secondary-container);color:var(--on-secondary-container)}
.feature-card:hover .feature-icon{border-radius:28px;transform:rotate(-6deg) scale(1.06)}
.feature-icon svg{width:28px;height:28px}
.feature-card h3{font-size:1.18rem;font-weight:700;letter-spacing:-.01em;margin-bottom:10px}
.feature-card p{font-size:.94rem;color:var(--on-surface-variant)}

/* ============================================================
   Presets
   ============================================================ */
.presets{background:linear-gradient(180deg,var(--surface) 0%,var(--bg) 100%)}
.preset-switch{display:flex;gap:10px;margin-bottom:40px;flex-wrap:wrap}
.preset-btn{
  position:relative;display:inline-flex;align-items:center;gap:10px;
  min-height:52px;padding:0 28px;border-radius:999px;
  background:var(--surface-high);border:1.5px solid var(--outline-variant);
  font-weight:700;font-size:1rem;color:var(--on-surface-variant);
  transition:transform .3s var(--ease-spring),border-color .3s var(--ease-out),background-color .3s var(--ease-out),color .3s var(--ease-out);
}
.preset-btn svg{width:20px;height:20px}
.preset-btn[aria-pressed="true"]{
  background:var(--primary);border-color:var(--primary);color:var(--on-primary);
  box-shadow:0 10px 30px -10px rgba(223,226,120,.55);
}
.preset-btn:active{transform:scale(.96)}
.preset-panel{display:none}
.preset-panel.active{display:block;animation:panel-in .5s var(--ease-spring)}
@keyframes panel-in{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}
.preset-body{
  display:grid;grid-template-columns:1.7fr .8fr;gap:clamp(24px,4vw,48px);align-items:stretch;
  background:var(--surface);border:1px solid var(--outline-variant);
  border-radius:var(--radius-xl);padding:clamp(26px,3.6vw,44px);
}
.preset-main{min-width:0}
.preset-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px}
.preset-title{font-size:1.4rem;font-weight:800;letter-spacing:-.02em;line-height:1.2}
.preset-desc{margin-top:6px;color:var(--on-surface-variant);font-size:.92rem;max-width:44ch}
.preset-count{flex:none;white-space:nowrap}
.preset-tweaks{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.preset-tweak{
  display:flex;align-items:center;gap:12px;
  background:var(--surface-container);border:1px solid var(--outline-variant);
  border-radius:var(--radius-md);
  padding:11px 14px;font-size:.9rem;font-weight:600;
  transition:transform .3s var(--ease-spring),border-color .3s var(--ease-out);
}
.preset-tweak:hover{transform:translateX(4px);border-color:color-mix(in srgb,var(--primary) 45%,var(--outline-variant))}
.preset-tweak svg{
  width:18px;height:18px;padding:3px;flex:none;
  border-radius:50%;background:var(--primary-container);color:var(--on-primary-container);
}
.preset-visual{
  position:sticky;top:calc(var(--appbar-h) + 20px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;
  background:linear-gradient(165deg,var(--surface-high) 0%,var(--surface-container) 100%);
  border:1px solid var(--outline-variant);border-radius:var(--radius-lg);
  padding:34px 26px;
}
.preset-visual .blob{position:static;width:124px;height:124px;animation:blob-rot 20s linear infinite}
.preset-visual .blob-halo{position:static;width:144px;height:144px;border-radius:50%}
.preset-visual p{font-weight:600;font-size:.9rem;color:var(--on-surface-variant);max-width:28ch;line-height:1.55}

/* ============================================================
   Safety
   ============================================================ */
.safety-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.safety-card{
  background:var(--surface);border:1px solid var(--outline-variant);
  border-radius:var(--radius-lg);padding:32px 28px;text-align:center;
  transition:transform .4s var(--ease-spring),border-color .3s var(--ease-out);
}
.safety-card:hover{transform:translateY(-6px);border-color:color-mix(in srgb,var(--tertiary) 40%,var(--outline-variant))}
.safety-icon{
  width:64px;height:64px;margin:0 auto 20px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:var(--tertiary-container);color:var(--on-tertiary-container);
  box-shadow:0 0 0 8px color-mix(in srgb,var(--tertiary-container) 40%,transparent);
}
.safety-icon svg{width:30px;height:30px}
.safety-card h3{font-size:1.12rem;font-weight:700;margin-bottom:8px}
.safety-card p{font-size:.92rem;color:var(--on-surface-variant)}

/* ---------- How it works ---------- */
.flow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.flow-card{
  position:relative;background:var(--surface);border:1px solid var(--outline-variant);
  border-radius:var(--radius-lg);padding:28px 24px;
  transition:transform .4s var(--ease-spring),border-color .3s var(--ease-out);
}
.flow-card:hover{transform:translateY(-6px);border-color:color-mix(in srgb,var(--tertiary) 40%,var(--outline-variant))}
.flow-num{
  width:42px;height:42px;border-radius:14px;margin-bottom:18px;
  display:flex;align-items:center;justify-content:center;
  background:var(--primary-container);color:var(--on-primary-container);
  font-weight:800;font-size:1.05rem;
  transition:border-radius .4s var(--ease-spring),transform .4s var(--ease-spring);
}
.flow-card:nth-child(2n) .flow-num{background:var(--tertiary-container);color:var(--on-tertiary-container)}
.flow-card:hover .flow-num{border-radius:50%;transform:rotate(-8deg)}
.flow-card h3{font-size:1.08rem;font-weight:700;margin-bottom:8px;letter-spacing:-.01em}
.flow-card p{font-size:.92rem;color:var(--on-surface-variant)}
@media (max-width:980px){.flow-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:720px){.flow-grid{grid-template-columns:1fr}}

/* ============================================================
   Debloat demo
   ============================================================ */
.debloat{background:linear-gradient(180deg,var(--bg) 0%,var(--surface) 100%)}
.debloat-layout{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:start}
.debloat-list{display:flex;flex-direction:column;gap:12px}
.debloat-row{
  display:flex;align-items:center;gap:16px;
  background:var(--surface);border:1px solid var(--outline-variant);
  border-radius:var(--radius-lg);padding:16px 18px;
  transition:transform .3s var(--ease-spring),border-color .3s var(--ease-out),opacity .3s var(--ease-out);
}
.debloat-row:hover{transform:translateX(6px);border-color:color-mix(in srgb,var(--primary) 40%,var(--outline-variant))}
.debloat-row.removing{opacity:.45;transform:translateX(-10px) scale(.98)}
.debloat-icon{
  width:44px;height:44px;border-radius:14px;flex:none;
  display:flex;align-items:center;justify-content:center;
  background:var(--surface-high);color:var(--on-surface-variant);
}
.debloat-icon svg{width:22px;height:22px}
.debloat-meta{min-width:0}
.debloat-meta b{display:block;font-size:.98rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.debloat-meta span{font-size:.8rem;font-weight:600;color:var(--on-surface-variant)}
.badge{
  display:inline-block;margin-left:8px;padding:3px 10px;border-radius:999px;
  font-size:.68rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
}
.badge-rec{background:var(--primary-container);color:var(--on-primary-container)}
.badge-opt{background:var(--tertiary-container);color:var(--on-tertiary-container)}
.badge-cau{background:color-mix(in srgb,var(--error) 22%,transparent);color:var(--error)}
.debloat-actions{margin-left:auto;display:flex;align-items:center}
.debloat-legend{display:flex;flex-wrap:wrap;gap:10px 22px;margin-bottom:18px;align-items:center}
.debloat-legend .lg-item{display:inline-flex;align-items:center;gap:8px;font-size:.8rem;font-weight:600;color:var(--on-surface-variant)}
.debloat-legend .badge{margin:0}
.debloat-actions .remove-btn{
  width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  background:var(--surface-high);color:var(--on-surface-variant);
  transition:background-color .25s var(--ease-out),color .25s var(--ease-out),transform .25s var(--ease-spring);
}
.debloat-actions .remove-btn:hover{background:color-mix(in srgb,var(--error) 25%,var(--surface-high));color:var(--error)}
.debloat-actions .remove-btn:active{transform:scale(.88)}
.debloat-actions .remove-btn svg{width:19px;height:19px}

.scan-box{
  background:var(--surface);border:1px solid var(--outline-variant);
  border-radius:var(--radius-xl);padding:clamp(26px,3.5vw,40px);text-align:center;
}
.scan-box h3{font-size:1.4rem;font-weight:800;letter-spacing:-.02em;margin-bottom:10px}
.scan-box p{color:var(--on-surface-variant);font-size:.95rem;max-width:38ch;margin-inline:auto;margin-bottom:26px}
.scan-progress{
  height:10px;border-radius:999px;background:var(--surface-high);
  overflow:hidden;margin-bottom:14px;
}
.scan-progress i{
  display:block;height:100%;width:0%;border-radius:999px;
  background:linear-gradient(90deg,var(--primary),var(--tertiary));
  transition:width .12s linear;
}
.scan-status{font-weight:700;font-size:.92rem;color:var(--on-surface-variant);min-height:1.6em}
.scan-done .scan-status{color:var(--tertiary)}

/* ============================================================
   FAQ
   ============================================================ */
.faq{max-width:760px;margin-inline:auto}
.faq-item{background:var(--surface);border:1px solid var(--outline-variant);border-radius:var(--radius-lg);margin-bottom:14px;overflow:hidden}
.faq-btn{
  width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:22px 26px;text-align:left;font-weight:700;font-size:1.05rem;
  transition:background-color .25s var(--ease-out);
}
.faq-btn:hover{background:color-mix(in srgb,var(--on-surface) 4%,transparent)}
.faq-btn .chev{
  flex:none;width:22px;height:22px;color:var(--on-surface-variant);
  transition:transform .35s var(--ease-spring);
}
.faq-item.open .faq-btn .chev{transform:rotate(180deg);color:var(--primary)}
.faq-answer{padding:0 26px;overflow:hidden}
.faq-answer p{padding-bottom:22px;color:var(--on-surface-variant);font-size:.96rem}

/* ============================================================
   CTA + footer
   ============================================================ */
.cta-wrap{
  position:relative;overflow:hidden;
  background:linear-gradient(120deg,var(--primary-container) 0%,var(--surface) 55%);
  border:1px solid var(--outline-variant);
  border-radius:calc(var(--radius-xl) + 8px);
  padding:clamp(48px,7vw,84px);text-align:center;
}
.cta-wrap::before{
  content:"";position:absolute;inset:-40% auto auto 55%;width:60%;aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle,rgba(166,217,192,.22),transparent 65%);
  filter:blur(50px);pointer-events:none;
}
.cta-wrap h2{position:relative;font-size:clamp(1.9rem,4vw,3rem);font-weight:800;letter-spacing:-.025em;text-wrap:balance}
.cta-wrap p{position:relative;margin:16px auto 34px;max-width:46ch;color:var(--on-surface-variant);font-size:1.05rem}
.cta-actions{position:relative;display:flex;justify-content:center;flex-wrap:wrap;gap:14px}
.cta-mini-blob{
  position:absolute;width:120px;height:120px;left:7%;top:-30px;opacity:.5;pointer-events:none;
  animation:blob-rot 22s linear infinite;
}
footer{border-top:1px solid var(--outline-variant);padding:56px 0 40px;background:var(--bg)}
.foot-grid{display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start;justify-content:space-between}
.foot-brand{max-width:300px}
.foot-brand p{font-size:.9rem;color:var(--on-surface-variant);margin-top:12px}
.foot-col b{display:block;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--on-surface-variant);margin-bottom:14px}
.foot-col a{display:block;padding:6px 0;font-size:.92rem;font-weight:600;color:var(--on-surface);transition:color .2s var(--ease-out),transform .25s var(--ease-spring)}
.foot-col a:hover{color:var(--primary);transform:translateX(4px)}
.foot-bottom{
  margin-top:44px;padding-top:24px;border-top:1px solid var(--outline-variant);
  display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;
  font-size:.84rem;color:var(--on-surface-variant);
}

/* ---------- Mobile nav ---------- */
.menu-btn{display:none;width:44px;height:44px;border-radius:50%;align-items:center;justify-content:center;color:var(--on-surface)}
.menu-btn:hover{background:var(--surface-high)}
.menu-btn svg{width:24px;height:24px}

/* ============================================================
   Responsive
   ============================================================ */
@media (max-width:980px){
  .hero-inner{grid-template-columns:1fr;text-align:center}
  .hero-sub{margin-inline:auto}
  .hero-cta,.hero-note{justify-content:center}
  .hero-stats{grid-template-columns:repeat(2,1fr);gap:24px}
  .blob-stage{width:min(70vw,360px);order:-1}
  .feature-grid,.safety-grid{grid-template-columns:repeat(2,1fr)}
  .preset-body{grid-template-columns:1fr;text-align:left}
  .preset-head{flex-direction:column;align-items:flex-start;text-align:left}
  .preset-visual{position:static}
  .preset-tweaks{grid-template-columns:1fr}
  .debloat-layout{grid-template-columns:1fr}
}
@media (max-width:720px){
  .appbar-nav{display:none}
  .appbar-actions .btn-text{display:none}
  .menu-btn{display:inline-flex}
  .feature-grid,.safety-grid{grid-template-columns:1fr}
  .preset-tweaks{grid-template-columns:1fr}
  .mobile-menu{
    position:fixed;inset:var(--appbar-h) 0 auto 0;z-index:99;
    background:color-mix(in srgb,var(--surface) 96%,transparent);
    backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
    border-bottom:1px solid var(--outline-variant);
    padding:16px;display:flex;flex-direction:column;gap:6px;
    transform:translateY(-8px);opacity:0;pointer-events:none;
    transition:transform .3s var(--ease-out),opacity .3s var(--ease-out);
  }
  .mobile-menu.open{transform:none;opacity:1;pointer-events:auto}
  .mobile-menu a{padding:14px 18px;border-radius:16px;font-weight:700;font-size:1.05rem}
  .mobile-menu a:hover{background:var(--surface-high)}
}

/* ============================================================
   Reduced motion
   ============================================================ */
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  [data-reveal]{opacity:1;transform:none}
}
</style>
</head>
