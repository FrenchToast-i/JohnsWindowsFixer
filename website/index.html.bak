      <h3>See it work, first</h3>
      <p>Watch what the app finds on a typical PC — no download required.</p>
      <button class="btn btn-filled" id="scanBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        Scan my PC
      </button>
      <div class="scan-progress" aria-hidden="true" style="margin-top:28px"><i id="scanBar"></i></div>
      <div class="scan-status" id="scanStatus" role="status" aria-live="polite">Ready to scan</div>
    </div>
